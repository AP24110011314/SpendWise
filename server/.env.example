# Server Environment Configuration
NODE_ENV=production
PORT=10000

# MongoDB Atlas connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/spendwise?retryWrites=true&w=majority
#MONGODB_URI=mongodb://127.0.0.1:27017/spendwise

# Must be a secure random string of at least 32 characters:
JWT_SECRET=your-super-secret-jwt-key-with-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) (comma-separated, supports wildcard e.g. *.vercel.app):
CLIENT_ORIGIN=https://spend-wise-delta-five.vercel.app,http://localhost:5173,http://localhost:5174,https://*.vercel.app

# Cookie and Cron settings:
COOKIE_NAME=sw_token
ENABLE_CRON=true
RECURRING_CRON=5 0 * * *
LOG_LEVEL=info